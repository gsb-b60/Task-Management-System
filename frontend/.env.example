# Local development configuration. Copy to `.env.local` — never commit a real
# `.env`. `VITE_*` values are inlined at build time, so changing one after a
# production build does nothing (Phase 12/13).
VITE_API_URL="http://localhost:3000/api"

# The backend is still a scaffold, so the mock API layer answers by default.
# Set to false once Phase 01+ is running to talk to it over fetch instead.
VITE_USE_MOCK_API=true

# Simulated latency in milliseconds for the mock layer. 0 makes it instant.
VITE_MOCK_LATENCY=250