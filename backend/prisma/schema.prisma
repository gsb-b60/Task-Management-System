generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum IssueState {
  open
  closed
}

enum Visibility {
  public
  private
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique @db.Citext
  passwordHash      String?
  displayName       String?
  githubId          String?  @unique
  githubLogin       String?
  githubAccessToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions Session[]
  projects Project[]
  tasks    Task[]

  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  targetDate  DateTime?
  userId      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  githubRepo GitHubRepository?

  @@index([userId])
  @@index([userId, deletedAt])
}

model Task {
  id                 String       @id @default(uuid())
  title              String       @db.Citext
  description        String?
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  startDate          DateTime?
  dueDate            DateTime?
  userId             String
  projectId          String?
  githubIssueNumber  Int?
  githubState        IssueState?
  githubRepositoryId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubRepository GitHubRepository? @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, projectId])
  @@unique([githubRepositoryId, githubIssueNumber])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "task_title_trgm_idx", type: Gin)
}

model GitHubRepository {
  id            String     @id @default(uuid())
  githubId      BigInt     @unique
  name          String
  fullName      String
  owner         String
  description   String?
  visibility    Visibility
  defaultBranch String?
  url           String?
  projectId     String     @unique

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([githubId])
}
