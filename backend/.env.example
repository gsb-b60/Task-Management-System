# Placeholder values only — never commit real credentials. (Phase 00 §9)
NODE_ENV=development
PORT=5004
# Comma-separated allow-list; every frontend origin that may call the API
# with credentials (host dev, compose web, Kong).
FRONTEND_ORIGIN="http://localhost:5173"

# Phase 00 — database
# Docker Compose (postgres:16, port 5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todogit?schema=public"
# Native install on a non-default port looks like:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/todogit?schema=public"

# Phase 01 — auth (sessions are opaque tokens; these name the policy)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12
# Session-cookie Secure attribute. Unset = true when NODE_ENV=production.
# Set "false" for plain-http origins (localhost over http) or the browser
# drops the cookie and login loops. Compose sets this in docker-compose.yml.
COOKIE_SECURE="false"

# Phase 01 — GitHub OAuth (leave empty to disable GitHub sign-in)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5004/api/auth/github/callback"
